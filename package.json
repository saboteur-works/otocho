{
  "name": "otocho",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Otocho — a DAW-agnostic notebook and idea sketchpad for audio projects.",
  "scripts": {
    "dev": "pnpm --filter @otocho/app dev",
    "build": "pnpm --filter @otocho/app build",
    "storybook": "pnpm --filter @otocho/ui storybook",
    "build-storybook": "pnpm --filter @otocho/ui build-storybook",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  }
}
